# Add to the existing Caddyfile. Attach gateway to the same Docker network as Caddy.
catetindulu.amarlo.online {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy same-origin
    X-Frame-Options DENY
    Strict-Transport-Security "max-age=31536000"
  }
  reverse_proxy catetindulu-gateway-1:3000
}
